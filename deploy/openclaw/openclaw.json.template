{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "http": {
      "endpoints": {
        "responses": {
          "enabled": true
        }
      }
    }
  },
  "auth": {
    "profiles": {
      "qwen:default": {
        "provider": "qwen",
        "mode": "api_key"
      }
    }
  },
  "models": {
    "providers": {
      "qwen": {
        "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "api": "openai-completions",
        "models": [
          {
            "id": "qwen3.5-plus",
            "name": "qwen3.5-plus",
            "reasoning": false,
            "input": ["text", "image"],
            "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
            "contextWindow": 1000000,
            "maxTokens": 65536
          },
          {
            "id": "qwen3.6-plus",
            "name": "qwen3.6-plus",
            "reasoning": false,
            "input": ["text", "image"],
            "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
            "contextWindow": 1000000,
            "maxTokens": 65536
          },
          {
            "id": "qwen3-max-2026-01-23",
            "name": "qwen3-max-2026-01-23",
            "reasoning": false,
            "input": ["text"],
            "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
            "contextWindow": 262144,
            "maxTokens": 65536
          },
          {
            "id": "qwen3-coder-next",
            "name": "qwen3-coder-next",
            "reasoning": false,
            "input": ["text"],
            "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
            "contextWindow": 262144,
            "maxTokens": 65536
          },
          {
            "id": "qwen3-coder-plus",
            "name": "qwen3-coder-plus",
            "reasoning": false,
            "input": ["text"],
            "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
            "contextWindow": 1000000,
            "maxTokens": 65536
          },
          {
            "id": "MiniMax-M2.5",
            "name": "MiniMax-M2.5",
            "reasoning": true,
            "input": ["text"],
            "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
            "contextWindow": 1000000,
            "maxTokens": 65536
          },
          {
            "id": "glm-5",
            "name": "glm-5",
            "reasoning": false,
            "input": ["text"],
            "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
            "contextWindow": 202752,
            "maxTokens": 16384
          },
          {
            "id": "glm-4.7",
            "name": "glm-4.7",
            "reasoning": false,
            "input": ["text"],
            "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
            "contextWindow": 202752,
            "maxTokens": 16384
          },
          {
            "id": "kimi-k2.5",
            "name": "kimi-k2.5",
            "reasoning": false,
            "input": ["text", "image"],
            "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
            "contextWindow": 262144,
            "maxTokens": 32768
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "model": {
        "primary": "${OPENCLAW_PRIMARY_MODEL}"
      },
      "skills": [
        "stayscape-product-generator",
        "stayscape-visitor-matcher"
      ]
    },
    "list": [
      {
        "id": "stayscape-main",
        "default": true,
        "workspace": "/home/node/.openclaw/workspace",
        "skills": [
          "stayscape-product-generator",
          "stayscape-visitor-matcher"
        ]
      }
    ]
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "tools": {
    "profile": "full",
    "allow": [
      "stayscape_get_hotel_context",
      "stayscape_list_available_products",
      "stayscape_create_product_draft"
    ],
    "deny": [
      "group:runtime",
      "group:fs",
      "group:ui",
      "group:nodes",
      "group:agents",
      "group:automation"
    ]
  },
  "plugins": {
    "enabled": true,
    "allow": ["stayscape-openclaw-plugin", "qwen", "feishu"],
    "load": {
      "paths": [
        "/opt/stayscape/openclaw-plugin",
        "${OPENCLAW_RUNTIME_PLUGIN_ROOT}/node_modules/@openclaw/qwen-provider",
        "${OPENCLAW_RUNTIME_PLUGIN_ROOT}/node_modules/@openclaw/feishu"
      ]
    },
    "entries": {
      "stayscape-openclaw-plugin": {
        "enabled": true,
        "config": {
          "baseUrl": "${STAYSCAPE_API_INTERNAL_URL}",
          "token": "${STAYSCAPE_AGENT_TOOL_TOKEN}",
          "hotelId": "${STAYSCAPE_HOTEL_ID}"
        }
      },
      "qwen": {
        "enabled": true
      },
      "feishu": {
        "enabled": false
      }
    }
  },
  "channels": {
    "feishu": {
      "enabled": false,
      "connectionMode": "websocket",
      "defaultAccount": "default",
      "dmPolicy": "allowlist",
      "allowFrom": [],
      "groupPolicy": "allowlist",
      "groupAllowFrom": [],
      "groupSenderAllowFrom": [],
      "requireMention": true,
      "groupSessionScope": "group_sender",
      "dynamicAgentCreation": {
        "enabled": false
      },
      "accounts": {
        "default": {
          "appId": "${FEISHU_APP_ID}",
          "appSecret": "${FEISHU_APP_SECRET}",
          "domain": "feishu"
        }
      }
    }
  }
}
