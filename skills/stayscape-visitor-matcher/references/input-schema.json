{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["adult_count", "child_count", "child_ages", "budget", "weather", "products"],
  "properties": {
    "natural_language": {"type": "string"},
    "adult_count": {"type": "integer", "minimum": 1},
    "child_count": {"type": "integer", "minimum": 0},
    "child_ages": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "budget": {"type": "string"},
    "weather": {"type": "string"},
    "target_crowd": {"type": "string"},
    "interests": {"type": "array"},
    "negative_interests": {"type": "array", "items": {"type": "string"}},
    "activity_level": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "allergy_information": {"type": "string"},
    "products": {"type": "array"}
  }
}
