APP_ENV=development
APP_NAME=StayScape
SECRET_KEY=change-me-before-production-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=120

DATABASE_URL=sqlite:///./stayscape.db
POSTGRES_DATABASE_URL=postgresql+psycopg://stayscape:stayscape@db:5432/stayscape
POSTGRES_DB=stayscape
POSTGRES_USER=stayscape
POSTGRES_PASSWORD=change-me-postgres-password

AGENT_PROVIDER=mock
AGENT_TIMEOUT_SECONDS=20
AGENT_MAX_RETRIES=1
MOCK_AGENT_MODE=normal
OPENCLAW_BASE_URL=
OPENCLAW_API_KEY=
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_MODEL=openclaw/default
OPENCLAW_TRANSPORT=responses
OPENCLAW_RESPONSES_PATH=/v1/responses
OPENCLAW_AGENT_ID=
OPENCLAW_SKILL_VERSION=1.0.0
# ClawHive is the preferred platform provider. These values point to the
# ClawHive-managed lobster/Agent bridge; keep tokens server-side only.
CLAWHIVE_BASE_URL=
CLAWHIVE_API_KEY=
CLAWHIVE_GATEWAY_TOKEN=
CLAWHIVE_MODEL=
CLAWHIVE_TRANSPORT=responses
CLAWHIVE_RESPONSES_PATH=/v1/responses
CLAWHIVE_AGENT_ID=
CLAWHIVE_SKILL_VERSION=1.0.0
POSTER_EMBED_REMOTE_IMAGES=false

CORS_ORIGINS=http://localhost:5173,http://localhost:8080
VITE_API_BASE_URL=/api/v1
STAYSCAPE_HTTP_PORT=8080
SEED_DEMO_ON_STARTUP=true
