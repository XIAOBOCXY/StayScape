APP_ENV=development
APP_NAME=StayScape
SECRET_KEY=change-me-before-production-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Local development uses SQLite. Docker replaces this with PostgreSQL.
DATABASE_URL=sqlite:///./stayscape.db
POSTGRES_DATABASE_URL=postgresql+psycopg://stayscape:stayscape@db:5432/stayscape
POSTGRES_DB=stayscape
POSTGRES_USER=stayscape
POSTGRES_PASSWORD=change-me-postgres-password

# Use a nearby trusted PyPI mirror for faster first deployment; override with
# https://pypi.org/simple on networks where the Aliyun mirror is not reachable.
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple

# demo = deterministic Mock Agent; live = one self-hosted OpenClaw Gateway.
MODE=demo
AGENT_PROVIDER=mock
AGENT_TIMEOUT_SECONDS=90
AGENT_MAX_RETRIES=1
MOCK_AGENT_MODE=normal

OPENCLAW_BASE_URL=
OPENCLAW_GATEWAY_TOKEN=
# OpenResponses request target and the model selected inside stayscape-main are
# intentionally separate. The first is a stable protocol default; the second
# is the provider/model configured in the OpenClaw runtime.
OPENCLAW_AGENT_TARGET=openclaw/default
# 只需要在服务器 .env 中改这一项来切换主对话模型。
OPENCLAW_PRIMARY_MODEL=qwen/qwen3.5-plus
QWEN_API_KEY=
# Optional, manually triggered BaiLian Wan visual generation. WAN_IMAGE_API_KEY may be blank to reuse QWEN_API_KEY.
WAN_IMAGE_ENABLED=false
WAN_IMAGE_MODEL=wan2.7-image
# Wan 2.7 uses the workspace endpoint automatically; copy this ID from the
# Model Studio workspace overview. Leave WAN_IMAGE_API_KEY empty to reuse QWEN_API_KEY.
WAN_IMAGE_WORKSPACE_ID=
WAN_IMAGE_REGION=cn-beijing
WAN_IMAGE_API_KEY=
WAN_IMAGE_SIZE=1536*2048
WAN_IMAGE_WATERMARK=true
WAN_IMAGE_TIMEOUT_SECONDS=90
OPENCLAW_TRANSPORT=responses
OPENCLAW_RESPONSES_PATH=/v1/responses
OPENCLAW_AGENT_ID=stayscape-main
OPENCLAW_SKILL_VERSION=1.0.0
OPENCLAW_SKILLS_READY=false
OPENCLAW_LIVE_READY=false
OPENCLAW_RUNTIME_VERSION=2026.6.9
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.6.9-slim

# Private server-to-plugin authentication. Never expose these to Vue.
STAYSCAPE_AGENT_TOOL_TOKEN=
STAYSCAPE_API_INTERNAL_URL=http://server:8000
STAYSCAPE_HOTEL_ID=1

# Optional official OpenClaw Feishu channel. Empty credentials keep Feishu off
# without affecting the Web/H5 deployment.
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DM_ALLOW_FROM=
FEISHU_GROUP_ALLOW_FROM=
FEISHU_GROUP_SENDER_ALLOW_FROM=
# Role is derived by FastAPI from the runtime sender, never trusted from the
# browser or a static plugin setting. Each value is a comma-separated open_id.
FEISHU_OPERATOR_ALLOW_FROM=
FEISHU_SUPPORT_ALLOW_FROM=
FEISHU_REQUIRE_MENTION=true

POSTER_EMBED_REMOTE_IMAGES=false
VISITOR_INTENT_HOLD_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
VITE_API_BASE_URL=/api/v1
STAYSCAPE_HTTP_PORT=8080
SEED_DEMO_ON_STARTUP=true
