{
  "id": "stayscape-openclaw-plugin",
  "name": "StayScape Business Tools",
  "description": "Allowlisted hotel facts, reviewed tourism knowledge and explicit-confirmation product proposals for StayScape Feishu operators.",
  "version": "1.0.0",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": { "type": "string" },
      "token": { "type": "string" },
      "hotelId": { "type": "integer", "minimum": 1 }
    },
    "required": ["baseUrl", "token", "hotelId"]
  },
  "activation": { "onStartup": true },
  "contracts": {
    "tools": [
      "stayscape_get_hotel_context",
      "stayscape_list_available_products",
      "stayscape_get_operations_insights",
      "stayscape_search_travel_knowledge",
      "stayscape_create_product_proposal",
      "stayscape_confirm_product_proposal"
    ]
  },
  "toolMetadata": {
    "stayscape_get_hotel_context": { "optional": true },
    "stayscape_list_available_products": { "optional": true },
    "stayscape_get_operations_insights": { "optional": true },
    "stayscape_search_travel_knowledge": { "optional": true },
    "stayscape_create_product_proposal": { "optional": true },
    "stayscape_confirm_product_proposal": { "optional": true }
  }
}
